VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# REsimpli live sync (server-side only — api/*.mjs — never prefixed VITE_, never imported
# by client code). See CLAUDE.md "REsimpli Live Sync" for what each one gates.
RESIMPLI_API_KEY=your_resimpli_open_api_key_here
CRON_SECRET=generate_a_random_value
RESIMPLI_WEBHOOK_SECRET=generate_a_random_value
# Database-layer secret checked inside the resimpli_sync_read/resimpli_sync_apply Postgres
# functions themselves (see supabase/resimpli_sync.sql) — separate from CRON_SECRET and
# RESIMPLI_WEBHOOK_SECRET, which only gate the Vercel functions.
RESIMPLI_SYNC_SECRET=generate_a_random_value

# Whiteboard cash-flow forecast (server-side only — api/*.mjs — never prefixed VITE_, never
# imported by client code). See CLAUDE.md "Whiteboard Cash-Flow Forecast". Each one is
# optional in the sense that a missing value degrades the Whiteboard gracefully (manual
# override / "source not connected"), never crashes it.
# Read-only Mercury API token for the "Master" checking account (••3564) — used only to show
# the Whiteboard's starting cash figure.
MERCURY_API_TOKEN=your_mercury_read_only_token_here
# The full service-account JSON key (not just the private key) downloaded from Google Cloud
# Console, as one line — used only to read the Dashboard Bot Office Dashboard Sheet's sell-side
# closing dates. Share that Sheet with the service account's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
