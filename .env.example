VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# REsimpli live sync (server-side only — api/*.mjs — never prefixed VITE_, never imported
# by client code). See CLAUDE.md "REsimpli Live Sync" for what each one gates.
RESIMPLI_API_KEY=your_resimpli_open_api_key_here
CRON_SECRET=generate_a_random_value
RESIMPLI_WEBHOOK_SECRET=generate_a_random_value
# Database-layer secret checked inside the resimpli_sync_read/resimpli_sync_apply Postgres
# functions themselves (see supabase/resimpli_sync.sql) — separate from CRON_SECRET and
# RESIMPLI_WEBHOOK_SECRET, which only gate the Vercel functions. Not applied to Supabase yet.
RESIMPLI_SYNC_SECRET=generate_a_random_value
